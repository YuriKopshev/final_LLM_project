# Скопируйте в .env и заполните. Файл .env в git не попадает.
APP_ENV=dev                      # dev | prod (профили в config/profiles/)

# Секреты YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Необязательные переопределения (иначе берутся значения из профиля)
# YANDEX_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
# YANDEX_MODEL=yandexgpt-lite
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=800
# CACHE_TTL_SECONDS=300
# LOG_LEVEL=INFO
# MAX_TEXT_LENGTH=20000
